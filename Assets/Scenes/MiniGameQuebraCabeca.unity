--- !u!114 &565202192
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 565202190}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: c9a265ca8bb7b7f40aecfadd3cbeae20, type: 3}
    m_FontSize: 17
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "A Fortaleza dos Reis Magos, no Rio Grande do Norte, foi uma das primeiras
    constru\xE7\xF5es militares de pedra do Brasil. Em 1630, um espi\xE3o holand\xEAs
    a descreveu como \"a melhor e mais s\xF3lida de toda a costa\".\r\n\r\nTr\xEAs
    anos depois, os holandeses a conquistaram, rebatizando-a de Castelo Keulen. Durante
    a ocupa\xE7\xE3o, contrataram at\xE9 mesmo engenheiros portugueses para refor\xE7ar
    suas defesas.\r\n\r\nCuriosamente, essas melhorias nunca foram usadas em batalha.
    Em 1654, com a rendi\xE7\xE3o holandesa em Recife, a guarni\xE7\xE3o abandonou
    o forte sem lutar. Os portugueses retomaram a fortaleza e continuaram suas obras,
    mas em um ritmo muito mais lento."
